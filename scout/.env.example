# Scout Pipeline — copy this to .env and fill in values
# (Never commit .env — it is gitignored)

# Supabase — 2026-08-27: consolidated onto the live dashboard project. The
# old separate Scout DB (fhfqjcvwcxizbioftvdw) is permanently gone (NXDOMAIN).
# SUPABASE_URL and LOVABLE_SUPABASE_URL are now the SAME project — see
# scout/migrations/004_consolidated_cloud.sql for the dovive_* raw scrape
# tables that were re-created there.
SUPABASE_URL=https://jwkitkfufigldpldqtbq.supabase.co
SUPABASE_KEY=your_service_role_key_here

# Lovable App DB (used by phase-living-brief.js) — same project as above now.
LOVABLE_SUPABASE_URL=https://jwkitkfufigldpldqtbq.supabase.co
LOVABLE_SUPABASE_KEY=your_lovable_service_role_key_here

# AI APIs
OPENROUTER_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Perplexity — P5 off-Amazon web discovery (scout/utils/perplexity.js).
# Replaces the old DuckDuckGo/Bright-Data-SERP search step, which returned 0
# links even through the Bright Data ISP proxy (SERP-scraping problem, not an
# IP-block problem). If unset, P5 falls back to the legacy DDG/SERP path.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# Keepa API — required by keepa-phase2.js and phase0-market-opportunity.js.
# dovive_scout_config table is a legacy fallback only (RLS-locked, service-role
# only) — always set this env var for local/worker runs.
KEEPA_API_KEY=

# Scraping
# APIFY_KEY removed 2026-08-27 — Apify is no longer a valid data source
# (Keepa, Bright Data fallback, and Playwright scraping only). Reviews now
# scraped directly by playwright-reviews.js.
AMAZON_EMAIL=
AMAZON_PASSWORD=

# Bright Data — Phase 1 (human-bsr.js) fallback when Amazon bot-walls the
# Cloud Run Job's Playwright scraper. Read as BRIGHTDATA_API_KEY first, then
# BRIGHTDATA (the name already used for the Dovive Supabase edge function
# secret) so either name resolves. See scout/bright-data-amazon.js.
BRIGHTDATA_API_KEY=

# Notifications
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
